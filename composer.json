{
    "name": "sayamaapps/kirby-genba",
    "description": "Build stamp, pre-deploy checks, smoke test and link check for deployed Kirby CMS sites.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": ["kirby", "kirby-plugin", "kirby-5", "deployment", "smoke-test", "ci", "operations", "link-check"],
    "homepage": "https://github.com/sayamaapps/kirby-genba",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-genba/issues",
        "source": "https://github.com/sayamaapps/kirby-genba"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0"
    },
    "bin": [
        "bin/genba-stamp",
        "bin/genba-preflight",
        "bin/genba-precheck",
        "bin/genba-smoke",
        "bin/genba-links"
    ],
    "scripts": {
        "test": "sh tests/run.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "genba",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
