#!/usr/bin/env php
<?php
/**
 * Runs the project's own generation step before the build (the npm script
 * `praeflug`): SVG motifs, font files, data imports. Run it from the
 * project root before `npm run build` (docs/SPEC.md §3.2).
 *
 *   vendor/bin/genba-preflight                   package.json "preflight", else "praeflug"
 *   vendor/bin/genba-preflight --hook='node scripts/x.mjs'
 *
 * Settings (argument, then environment, then package.json):
 *   --hook=COMMAND / GENBA_PREFLIGHT_HOOK   the value none switches the step off
 *
 * Without any hook it reports "SKIPPED" and exits 0.
 * Exit codes: 0 passed or skipped, 1 the hook failed, 2 usage error or the hook
 * cannot be started. Logic lives in src/Preflight.php.
 */
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}
require_once dirname(__DIR__) . '/src/Preflight.php';
exit(Sayamaapps\Genba\Preflight::run(getenv(), $argv, (string) getcwd(), STDOUT, STDERR));
