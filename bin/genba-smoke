#!/usr/bin/env bash
# Genba smoke test: the post-deploy check of a live Kirby site (SPEC §3.4).
#
# Port of kirby-starter/scripts/smoke-test.sh (the 300-line variant). A status
# code proves little: after a half upload, on the hoster's default page or
# with an old build the server also answers 200. So the content is measured:
#
#   0. reachability gate (optional): the name resolves, the preview
#      protection answers 401 without credentials
#   1. homepage: build stamp and marker       5. stylesheets, fonts, images
#   2. unknown address answers 404            6. http -> https redirect
#   3. robots.txt, sitemap.xml, llms.txt      7. Panel: account present,
#   4. every sitemap page                        installer locked
#   7b. Panel: /panel answers, the JS and CSS files it names arrive
#   8. nothing above public/ is reachable (private paths)
#   9. response headers (GENBA_HEADERS)
#
# curl fetches, PHP reads: the saved homepage is read by
# bin/genba-smoke-read (src/Homepage.php) with an HTML5 parser; bash keeps the
# network, the checks, the messages and the exit codes. Needs bash, curl, php.
#
# Usage: bin/genba-smoke [URL]     (bin/genba-smoke --help lists every setting)
# Exit:  0 passed (or visibly SKIPPED), 1 findings, 2 cannot run.
set -euo pipefail

# cannot_run MESSAGE: a usage or environment error, exit 2. SPEC §3.0: the
# last line of every run names the tool and the outcome, exit 2 included, so a
# log reader never has to guess why the check did not run.
cannot_run() {
  echo "::error::$*"
  echo "Genba smoke: FAILED — cannot run"
  exit 2
}

usage() {
  cat <<'EOF'
Usage: bin/genba-smoke [URL]
       bin/genba-smoke --help

Post-deploy smoke test of a live site: build stamp, content, delivery, Panel.
The address comes from the first argument or GENBA_URL.

Settings (environment variables):
  GENBA_URL                   base address, https://... (required)
  GENBA_EXPECTED_BUILD        commit hash that must be live, 7-64 hex digits; a short
                              hash is matched as the prefix of the live one
                              (default: GENBA_SHA, else git rev-parse HEAD in the
                              working directory)
  GENBA_META                  name of the build meta tag, [A-Za-z0-9_-]+ (default: build)
  GENBA_MARKER                text the homepage must contain, anywhere in the HTML,
                              comments included (default: assets/css/tailwind.css,
                              empty = off)
  GENBA_USER, GENBA_PASSWORD  Basic Auth for a protected preview (both or neither;
                              https only, plain http only to 127.0.0.1, localhost, [::1])
  GENBA_WITHOUT_CREDENTIALS   fail (default) | skip: a 401 without credentials
                              ends the run as SKIPPED, visibly
  GENBA_EXPECT_PROTECTED      0 (default) | 1: the first request, WITHOUT credentials,
                              must answer 401 (a protected preview), else a finding
  GENBA_NOT_READY             fail (default) | skip: a host that is not ready yet (the
                              name does not resolve, or the https connection fails
                              (TLS or connect error, not a timeout, not an expired
                              certificate) while http answers) ends the run as
                              SKIPPED, visibly; decided once, on the first request
  GENBA_HTTPS_REDIRECT        require (default) | warn | off
  GENBA_PANEL_ACCOUNT         require (default) | warn | off
  GENBA_PANEL_PATH            address of the Panel, /path (default: /panel), for a site
                              with its own panel.slug; letters, digits, _ ~ -, / between
  GENBA_API_PATH              address of the Panel API, /path (default: /api), for a site
                              with its own api.slug; the same rule
  GENBA_FOREIGN_SITEMAP       rewrite | warn | fail: sitemap entries on another
                              origin (staging listing production) are fetched on the
                              GENBA_URL origin | a warning | a finding. Default: rewrite
                              on a preview run (GENBA_EXPECT_PROTECTED=1 or GENBA_USER
                              set), else fail; the log names the default taken
  GENBA_CLOSED_PREVIEW        accept | fail: a closed preview (robots.txt Disallow: /
                              and an empty sitemap, as the Sudare package serves it)
                              is accepted, or a finding. Default: accept on a preview
                              run (GENBA_EXPECT_PROTECTED=1 or GENBA_USER set), else fail
  GENBA_SITEMAP_ORIGIN        https://... : the one foreign origin the sitemap may list
                              (production); entries on any other origin are a finding
  GENBA_PRIVATE_PATHS         paths that must not answer 2xx, ADDED to the default list
                              (site/config/config.php, .env, .git/HEAD, vendor/ ...);
                              the entry none drops the default, none alone = off
  GENBA_HEADERS               response headers, one rule per line: "[/path] Name: rule",
                              rule = value (exact) | * (present) | none (absent) |
                              ~text (contains) | !~text (sent, does not contain); path
                              default /, it must answer 2xx or 3xx. Unset = not
                              checked (check 9)
  GENBA_PAGES_MAX             sitemap pages fetched (default: 30)
  GENBA_RETRIES               homepage attempts while a cache holds the old build (default: 3)
  GENBA_PAUSE                 seconds between attempts (default: 5)
  GENBA_HTTP_URL              address for the http check (default: http://<host>/; tests only)
  GENBA_MAX_TIME              seconds one request, and the homepage reader, may take
                              (default: 25; tests only)

Exit codes: 0 passed or SKIPPED, 1 findings, 2 cannot run.
EOF
}

# --- arguments ----------------------------------------------------------------
# An argument error wins over --help, whatever the order (SPEC §3.0):
# every argument is read first, the first error is reported, --help only after.
URL_ARG=''
URL_COUNT=0
HELP=0
ARG_ERROR=''
ARG_USAGE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      HELP=1
      ;;
    -*)
      if [[ -z "$ARG_ERROR" ]]; then
        ARG_ERROR="Unknown argument: $1"
        ARG_USAGE=1
      fi
      ;;
    *)
      URL_COUNT=$((URL_COUNT + 1))
      if [[ -z "$ARG_ERROR" ]]; then
        if (( URL_COUNT > 1 )); then
          ARG_ERROR="Only one URL argument is allowed"
        elif [[ -z "$1" ]]; then
          # An empty argument ("${{ vars.PREVIEW_URL }}" with the variable unset)
          # must not fall back to GENBA_URL without a word — the rule for an empty
          # --option= in the other tools: a usage error, never a silent fall-back.
          ARG_ERROR="URL argument is empty (set GENBA_URL or pass the address)"
        fi
      fi
      URL_ARG=$1
      ;;
  esac
  shift
done
if [[ -n "$ARG_ERROR" ]]; then
  if (( ARG_USAGE )); then
    usage >&2
  fi
  cannot_run "$ARG_ERROR"
fi
if (( HELP )); then
  usage
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  cannot_run "curl not found"
fi

URL=${URL_ARG:-${GENBA_URL:-}}
if [[ -z "$URL" ]]; then
  cannot_run "GENBA_URL missing (base address of the site)"
fi
URL=${URL%/}
if [[ ! "$URL" =~ ^https?:// ]]; then
  cannot_run "GENBA_URL must start with http:// or https://"
fi
# The authority is everything between :// and the first / ? or #.
AUTHORITY=${URL#*://}
AUTHORITY=${AUTHORITY%%[/?#]*}
if [[ "$AUTHORITY" == *@* ]]; then
  # Not echoed: the value holds a password, and the log is readable.
  cannot_run "GENBA_URL must not contain credentials (user:password@host) — use GENBA_USER and GENBA_PASSWORD"
fi
ORIGIN="${URL%%://*}://$AUTHORITY"
if [[ "$AUTHORITY" == \[* ]]; then
  HOST="${AUTHORITY%%]*}]"
else
  HOST=${AUTHORITY%%:*}
fi

# normalize_origin ORIGIN -> how a browser compares origins: scheme and host in
# lower case, the default port (:80 for http, :443 for https) dropped. Kirby's
# url option is lower case; an operator may type vars.LIVE_URL with capitals.
normalize_origin() {
  local origin
  origin=$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<<"$1")
  case "$origin" in
    http://*:80) origin=${origin%:80} ;;
    https://*:443) origin=${origin%:443} ;;
  esac
  printf '%s\n' "$origin"
}
ORIGIN_NORMALIZED=$(normalize_origin "$ORIGIN")

# Same precedence as genba-stamp: GENBA_EXPECTED_BUILD, then GENBA_SHA, then git.
# Whitespace is dropped from both variables: `gh variable set` from a file
# keeps the trailing newline.
EXPECTED=${GENBA_EXPECTED_BUILD:-}
EXPECTED=${EXPECTED//[[:space:]]/}
EXPECTED_FROM=GENBA_EXPECTED_BUILD
if [[ -z "$EXPECTED" ]]; then
  EXPECTED=${GENBA_SHA:-}
  EXPECTED=${EXPECTED//[[:space:]]/}
  EXPECTED_FROM=GENBA_SHA
fi
if [[ -z "$EXPECTED" ]]; then
  # A missing git is named as such (as in genba-stamp): "not a git
  # checkout" would send the reader to the wrong cause.
  if ! command -v git >/dev/null 2>&1; then
    cannot_run "GENBA_EXPECTED_BUILD not set and git not found"
  fi
  EXPECTED=$(git rev-parse HEAD 2>/dev/null || true)
  EXPECTED_FROM='git rev-parse HEAD'
  if [[ -z "$EXPECTED" ]]; then
    cannot_run "GENBA_EXPECTED_BUILD not set and the working directory is not a git checkout"
  fi
fi
# 7 to 64 hex digits, like Stamp::PATTERN: a value shorter than the live hash
# is compared as its prefix (git's own abbreviation rule).
if [[ ! "$EXPECTED" =~ ^[0-9a-f]{7,64}$ ]]; then
  cannot_run "$EXPECTED_FROM is not a commit hash: $EXPECTED"
fi

META=${GENBA_META:-build}
# The same rule as Options::metaName() on the Kirby side: a name the snippet
# could never print would only read as "Homepage without <meta>".
if [[ ! "$META" =~ ^[A-Za-z0-9_-]+$ ]]; then
  cannot_run "GENBA_META must match [A-Za-z0-9_-]+ (the name of the <meta> element): $META"
fi
MARKER=${GENBA_MARKER-assets/css/tailwind.css}
HTTPS_MODE=${GENBA_HTTPS_REDIRECT:-require}
PANEL_MODE=${GENBA_PANEL_ACCOUNT:-require}
FOREIGN_MODE=${GENBA_FOREIGN_SITEMAP:-}
CLOSED_MODE=${GENBA_CLOSED_PREVIEW:-}
SITEMAP_ORIGIN=${GENBA_SITEMAP_ORIGIN:-}
SITEMAP_ORIGIN=${SITEMAP_ORIGIN%/}
CREDENTIALS_MODE=${GENBA_WITHOUT_CREDENTIALS:-fail}
EXPECT_PROTECTED=${GENBA_EXPECT_PROTECTED:-0}
NOT_READY_MODE=${GENBA_NOT_READY:-fail}
PAGES_MAX=${GENBA_PAGES_MAX:-30}
RETRIES=${GENBA_RETRIES:-3}
PAUSE=${GENBA_PAUSE:-5}
MAX_TIME=${GENBA_MAX_TIME:-25}
USER_NAME=${GENBA_USER:-}
PASSWORD=${GENBA_PASSWORD:-}

case "$HTTPS_MODE" in
  require|warn|off) ;;
  *) cannot_run "GENBA_HTTPS_REDIRECT must be require, warn or off" ;;
esac
case "$PANEL_MODE" in
  require|warn|off) ;;
  *) cannot_run "GENBA_PANEL_ACCOUNT must be require, warn or off" ;;
esac
# GENBA_PANEL_PATH and GENBA_API_PATH: the addresses of the Panel and its API on a
# site with its own panel.slug or api.slug. One path below the site root: a slash,
# then segments of letters, digits, _ ~ - separated by single slashes (no trailing
# slash, no dot segment, no query). Validated on every run, as the other settings.
PANEL_PATH=${GENBA_PANEL_PATH:-/panel}
API_PATH=${GENBA_API_PATH:-/api}
path_re='^/[A-Za-z0-9_~-]+(/[A-Za-z0-9_~-]+)*$'
[[ "$PANEL_PATH" =~ $path_re ]] || cannot_run "GENBA_PANEL_PATH must be a path below the site root: $PANEL_PATH"
[[ "$API_PATH" =~ $path_re ]] || cannot_run "GENBA_API_PATH must be a path below the site root: $API_PATH"
# GENBA_HEADERS: one rule per line, "[/path] Name: rule" (README, check 9).
# Read here, before the first request, so a broken line is a usage error and
# never a silent pass. Blank lines and lines starting with # are skipped.
HDR_PATH=()
HDR_NAME=()
HDR_RULE=()
while IFS= read -r hdr_line || [[ -n "$hdr_line" ]]; do
  hdr_line=${hdr_line%$'\r'}
  hdr_line=${hdr_line#"${hdr_line%%[![:space:]]*}"}
  hdr_line=${hdr_line%"${hdr_line##*[![:space:]]}"}
  if [[ -z "$hdr_line" || "$hdr_line" == \#* ]]; then
    continue
  fi
  hdr_path=/
  if [[ "$hdr_line" == /* ]]; then
    hdr_path=${hdr_line%%[[:space:]]*}
    hdr_line=${hdr_line#"$hdr_path"}
    hdr_line=${hdr_line#"${hdr_line%%[![:space:]]*}"}
    [[ "$hdr_path" =~ ^/[A-Za-z0-9._~/-]*$ ]] \
      || cannot_run "GENBA_HEADERS: path '$hdr_path' must be / followed by letters, digits, . _ ~ / -"
  fi
  [[ "$hdr_line" == *:* ]] || cannot_run "GENBA_HEADERS: a line needs 'Name: rule' (got: $hdr_line)"
  hdr_name=${hdr_line%%:*}
  hdr_name=${hdr_name%"${hdr_name##*[![:space:]]}"}
  hdr_rule=${hdr_line#*:}
  hdr_rule=${hdr_rule#"${hdr_rule%%[![:space:]]*}"}
  [[ "$hdr_name" =~ ^[A-Za-z0-9-]+$ ]] || cannot_run "GENBA_HEADERS: '$hdr_name' is not a header name"
  [[ -n "$hdr_rule" ]] || cannot_run "GENBA_HEADERS: the rule for $hdr_name is empty"
  # "~" alone would be "containing ''", true of every value sent: a rule that checks nothing.
  if [[ "$hdr_rule" == '~' || "$hdr_rule" == '!~' ]]; then
    cannot_run "GENBA_HEADERS: the rule for $hdr_name is '$hdr_rule' without text"
  fi
  HDR_PATH+=("$hdr_path")
  HDR_NAME+=("$hdr_name")
  HDR_RULE+=("$hdr_rule")
done <<< "${GENBA_HEADERS:-}"
case "$FOREIGN_MODE" in
  ''|rewrite|warn|fail) ;;
  *) cannot_run "GENBA_FOREIGN_SITEMAP must be rewrite, warn or fail" ;;
esac
case "$CLOSED_MODE" in
  ''|accept|fail) ;;
  *) cannot_run "GENBA_CLOSED_PREVIEW must be accept or fail" ;;
esac
case "$CREDENTIALS_MODE" in
  fail|skip) ;;
  *) cannot_run "GENBA_WITHOUT_CREDENTIALS must be fail or skip" ;;
esac
case "$EXPECT_PROTECTED" in
  0|1) ;;
  *) cannot_run "GENBA_EXPECT_PROTECTED must be 0 or 1" ;;
esac
case "$NOT_READY_MODE" in
  fail|skip) ;;
  *) cannot_run "GENBA_NOT_READY must be fail or skip" ;;
esac

# Paths above public/ that must never be served (a live site's deploy workflow,
# extended): an executed config.php answers 200 with an empty body, so any 2xx
# counts, not only 200 with content.
PRIVATE_DEFAULT='.env .git/HEAD composer.json composer.lock site/ site/config/config.php site/config/credentials.php site/config/kizami.php site/config/kennzahlen.php content/ content/site.txt kirby/bootstrap.php vendor/ vendor/autoload.php storage/ storage/kizami/kizami.sqlite storage/kennzahlen/kennzahlen.sqlite'
PRIVATE_EXTRA=''
PRIVATE_NONE=0
while IFS= read -r entry; do
  [[ -n "$entry" ]] || continue
  if [[ "$entry" == none ]]; then
    PRIVATE_NONE=1
    continue
  fi
  entry=${entry#/}
  if [[ ! "$entry" =~ ^[A-Za-z0-9._~/-]+$ || "/$entry/" == */../* ]]; then
    cannot_run "GENBA_PRIVATE_PATHS: not a path below the site root: $entry"
  fi
  PRIVATE_EXTRA="$PRIVATE_EXTRA $entry"
done < <(tr ',' ' ' <<<"${GENBA_PRIVATE_PATHS:-}" | tr ' ' '\n')
PRIVATE_PATHS=$PRIVATE_EXTRA
if (( PRIVATE_NONE == 0 )); then
  PRIVATE_PATHS="$PRIVATE_DEFAULT$PRIVATE_EXTRA"
fi
if [[ ! "$PAGES_MAX" =~ ^[1-9][0-9]*$ ]]; then
  cannot_run "GENBA_PAGES_MAX must be a whole number above 0: $PAGES_MAX"
fi
if [[ ! "$RETRIES" =~ ^[1-9][0-9]*$ ]]; then
  cannot_run "GENBA_RETRIES must be a whole number above 0: $RETRIES"
fi
if [[ ! "$PAUSE" =~ ^[0-9]+$ ]]; then
  cannot_run "GENBA_PAUSE must be a whole number of seconds: $PAUSE"
fi
if [[ ! "$MAX_TIME" =~ ^[1-9][0-9]*$ ]]; then
  cannot_run "GENBA_MAX_TIME must be a whole number of seconds above 0: $MAX_TIME"
fi
# ']' first and '[' inside the bracket expression: an IPv6 literal ([::1]:8443).
origin_re='^https?://[][A-Za-z0-9.:-]+$'
if [[ -n "$SITEMAP_ORIGIN" && ! "$SITEMAP_ORIGIN" =~ $origin_re ]]; then
  cannot_run "GENBA_SITEMAP_ORIGIN must be an origin without path (https://host or https://host:port): $SITEMAP_ORIGIN"
fi
SITEMAP_ORIGIN_NORMALIZED=''
if [[ -n "$SITEMAP_ORIGIN" ]]; then
  SITEMAP_ORIGIN_NORMALIZED=$(normalize_origin "$SITEMAP_ORIGIN")
fi
if [[ -n "$USER_NAME" || -n "$PASSWORD" ]]; then
  if [[ -z "$USER_NAME" || -z "$PASSWORD" ]]; then
    cannot_run "GENBA_USER and GENBA_PASSWORD must be set together"
  fi
  # A line break inside either value cannot reach curl: its -K file is read line
  # by line, so a LF ends the quoted value early (curl exit 26, every request
  # HTTP 000, the cause nowhere near the log line) and a CR would travel inside
  # the password. Refused before the first request, the value not echoed.
  nl=$'\n'
  cr=$'\r'
  if [[ "$USER_NAME" == *"$nl"* || "$USER_NAME" == *"$cr"* || "$PASSWORD" == *"$nl"* || "$PASSWORD" == *"$cr"* ]]; then
    cannot_run "GENBA_USER/GENBA_PASSWORD must not contain a line break (a secret set from a file keeps the file's line breaks)"
  fi
  # Basic Auth over plain http is the password in clear text on the wire.
  # Only the own machine is exempt (the tests' fake site runs there).
  if [[ "$URL" != https://* ]]; then
    case "$(tr '[:upper:]' '[:lower:]' <<<"$HOST")" in
      127.0.0.1|localhost|'[::1]') ;;
      *)
        cannot_run "GENBA_USER/GENBA_PASSWORD only over https: GENBA_URL is not https:// (plain http only to 127.0.0.1, localhost or [::1])"
        ;;
    esac
  fi
fi

# What the homepage and the sitemap may be and hold: a body above BODY_MAX_BYTES
# is not read (curl stops at --max-filesize, fetch() checks the size on disk
# for a curl that does not; for the homepage the bound matters most: the
# reader holds about 40 times the page in memory), an address
# above LOC_MAX characters — a <loc>, an href, a src, a url() — is a finding
# instead of a request and a log line of that length.
BODY_MAX_BYTES=10485760
LOC_MAX=2048

# --- text from the checked site --------------------------------------------------
# Everything the site sends can end up in a log line: a <loc>, an href, a src
# or srcset, a url() in a stylesheet, a Content-Type header, a redirect
# target, the build hash in the <meta>, curl's error text. ONE filter for all
# of them: strip_controls drops the
# control characters (an ESC or CR would rewrite the line, a "Genba smoke:
# PASSED." behind a CR would read as the last line, a line break would start a
# forged ::error:: annotation), log_text additionally cuts a value above
# LOC_MAX to its first 60 characters, too_long turns an address above LOC_MAX
# into a finding instead of a request. The homepage reader drops the
# same characters in PHP before its records reach this script (Homepage.php).
# What is NOT from the site and needs no
# filter: curl's status code (%{http_code}, digits only), the byte counts, the
# isInstalled/isInstallable values (grep-constrained to true|false), and every
# path, host and setting the run was given.
#
# Byte-wise: every sed, tr, grep, awk, cut, sort and paste that reads text from
# the site runs with LC_ALL=C, per call. In a UTF-8 locale
# a byte that is no UTF-8 (\377, a Latin-1 page) stops macOS tr and sed ("tr:
# Illegal byte sequence", "RE error: illegal byte sequence"), cut and sort, and
# truncates paste and BSD grep -o without a word — set -e would then end the
# run without its closing line. GNU tools are more lenient, so Linux CI does
# not show it. Not once for the whole script: bash measures and cuts ${#text} and
# ${text:0:60} by the locale, so log_text and too_long would count bytes and
# could cut an ä in half in a log line; the tools' output is the same bytes
# either way.

# strip_controls: stdin -> stdout without C0 control characters (the newline,
# which separates the records of the stream, excepted), DEL, and the C1 range
# U+0080–U+009F (UTF-8 \302\200–\302\237, which GitHub's log renders as nothing
# and a terminal may read as ESC sequences). awk in the C locale: byte-wise,
# BSD awk, gawk, mawk and busybox awk alike. A raw byte \200–\237 (a Latin-1 page,
# or \233 = the 8-bit CSI set on purpose) is dropped too — wherever it is not
# part of a well-formed UTF-8 character (ß is \303\237, € is \342\202\254, both
# kept; \351\233 is no character, its \233 goes). A line without any byte
# \200–\237 is printed as it is; any other is walked byte by byte (split into
# single bytes, the bytes printed one by one: linear, also in BSD awk, whose
# substr() and string concatenation copy the whole line). tr in the C locale
# too: macOS tr in a UTF-8 locale stops at the first such byte ("tr: Illegal
# byte sequence") and the rest of the stream is lost.
strip_controls() {
  LC_ALL=C tr -d '\000-\011\013-\037\177' | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    !/[\200-\237]/ { print; next }
    {
      n = split($0, ch, "")
      i = 1
      while (i <= n) {
        # The length of the UTF-8 character starting with byte b, and the range
        # of its second byte (RFC 3629: no overlong form, no surrogate, nothing
        # above U+10FFFF).
        b = ord[ch[i]]; len = 0; lo = 128; hi = 191
        if (b < 128) len = 1
        else if (b >= 194 && b <= 223) len = 2
        else if (b == 224) { len = 3; lo = 160 }
        else if (b == 237) { len = 3; hi = 159 }
        else if (b >= 225 && b <= 239) len = 3
        else if (b == 240) { len = 4; lo = 144 }
        else if (b >= 241 && b <= 243) len = 4
        else if (b == 244) { len = 4; hi = 143 }
        ok = len > 0 && i + len - 1 <= n
        if (ok && len > 1) { c = ord[ch[i + 1]]; if (c < lo || c > hi) ok = 0 }
        for (k = 2; ok && k < len; k++) { c = ord[ch[i + k]]; if (c < 128 || c > 191) ok = 0 }
        # Not a character: the byte alone, kept unless it is \200-\237.
        if (!ok) { if (b > 159) printf "%s", ch[i]; i++; continue }
        # A character, kept unless it is U+0080-U+009F (\302\200-\302\237).
        if (!(b == 194 && ord[ch[i + 1]] < 160)) for (k = 0; k < len; k++) printf "%s", ch[i + k]
        i += len
      }
      printf "\n"
    }'
}

# encode_controls: stdin -> stdout, one address per line, as the URL parser
# takes it (the homepage reader's url() in bash): leading
# and trailing C0 control characters and spaces stripped, tabs and CRs dropped
# (a line break ends the line already), every other C0 control, DEL and C1
# percent-encoded — \001 is %01, U+0085 (\302\205) is %C2%85. Dropped instead
# (strip_controls), /a\001b.woff2 would be requested as /ab.woff2, a
# file the browser never asks for. Bytes that are no
# UTF-8 character are U+FFFD, %EF%BF%BD — a stylesheet is read as UTF-8 whatever
# it declares (Kirby writes UTF-8), as the browser reads one without a charset
# parameter and asks for that; the homepage reader (Lexbor) reads the page so,
# and a <loc> that is no UTF-8 is no XML. One U+FFFD per maximal subpart, as the
# Encoding Standard's decoder: a lead byte with the continuation bytes that fit
# it (\351\233 before an ASCII byte is one), a byte that starts nothing alone
# (\232, \300, \377). Log text either way: nothing of a control
# character and no raw byte outside UTF-8 is left. A NUL is dropped (tr):
# awk cannot hold it, and neither CSS (which makes it U+FFFD) nor XML
# (which forbids it) passes it on. Only a line of printable ASCII is passed on
# as it is; every other one is walked byte by byte (the walk of strip_controls).
encode_controls() {
  LC_ALL=C tr -d '\000\011\015' | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    { sub(/^[\001-\040]+/, ""); sub(/[\001-\040]+$/, "") }
    /^[\040-\176]*$/ { print; next }
    {
      n = split($0, ch, "")
      i = 1
      while (i <= n) {
        b = ord[ch[i]]; len = 0; lo = 128; hi = 191
        if (b < 32 || b == 127) { printf "%%%02X", b; i++; continue }
        if (b < 128) { printf "%s", ch[i]; i++; continue }
        if (b >= 194 && b <= 223) len = 2
        else if (b == 224) { len = 3; lo = 160 }
        else if (b == 237) { len = 3; hi = 159 }
        else if (b >= 225 && b <= 239) len = 3
        else if (b == 240) { len = 4; lo = 144 }
        else if (b >= 241 && b <= 243) len = 4
        else if (b == 244) { len = 4; hi = 143 }
        # k: the lead byte and the continuation bytes that fit it (RFC 3629: the
        # second in lo-hi, no overlong form, no surrogate, nothing above
        # U+10FFFF; the others in \200-\277).
        k = 1
        while (len > 0 && k < len && i + k <= n) {
          c = ord[ch[i + k]]
          if (k == 1 && (c < lo || c > hi)) break
          if (k > 1 && (c < 128 || c > 191)) break
          k++
        }
        # Not a character: one U+FFFD for those k bytes; the byte that broke
        # the sequence starts the next one.
        if (len == 0 || k < len) { printf "%%EF%%BF%%BD"; i += k; continue }
        # A character: U+0080-U+009F (\302\200-\302\237) encoded, every other one kept.
        if (b == 194 && ord[ch[i + 1]] < 160) printf "%%C2%%%02X", ord[ch[i + 1]]
        else for (k = 0; k < len; k++) printf "%s", ch[i + k]
        i += len
      }
      printf "\n"
    }'
}

# log_text TEXT -> TEXT as one log line: every control character dropped, the
# newline included, a value above LOC_MAX cut to its first 60 characters with
# its length.
log_text() {
  local text
  text=$(printf '%s' "$1" | LC_ALL=C tr -d '\012' | strip_controls)
  if (( ${#text} > LOC_MAX )); then
    text="${text:0:60}… (${#text} characters)"
  fi
  printf '%s\n' "$text"
}

# curl_error FILE -> the first line of curl's stderr in FILE as log text (curl's
# message can quote what the server sent: a header, a reason phrase), empty when
# the file is empty or missing. The ONE reader of curl's error text: the gate's
# probe and fetch() alike.
curl_error() {
  local line=''
  if [[ -s "$1" ]]; then
    line=$(head -n 1 "$1")
  fi
  log_text "$line"
}

# fetch_detail -> " — <curl's message>" when the last fetch() failed in curl
# (FETCH_ERROR set), else nothing. Appended to every finding that names the
# HTTP code of a fetch, so a transfer that broke after the headers is never a
# bare "HTTP 000" with its cause nowhere in the log.
fetch_detail() {
  if [[ -n "$FETCH_ERROR" ]]; then
    printf ' — %s\n' "$FETCH_ERROR"
  fi
}

# too_long WHAT ADDRESS: an address above LOC_MAX characters is a finding and
# is not fetched — reported (0) or not (1). WHAT names where it came from
# ("Sitemap entry", "Stylesheet address", "Asset address").
too_long() {
  local what=$1 address=$2
  if (( ${#address} > LOC_MAX )); then
    # Printed cut short: the finding is the length, not the address.
    fail "$what longer than $LOC_MAX characters (${#address}), not fetched: ${address:0:60}…"
    return 0
  fi
  return 1
}

# decode_entities: stdin -> stdout with the character references a sitemap
# generator writes (htmlspecialchars with ENT_XML1) decoded: the five named ones and the numeric references for the ASCII
# characters that matter in a URL (& < > " ' # ? =), decimal and hex. The three
# spellings of & (&amp; &#38; &#x26;) come last and in ONE command, so that
# &amp;lt; stays the text "&lt;" and does not become "<", and &amp;#38; is
# decoded once, to "&#38;" — sed runs each command over the whole line again,
# so with &amp; in a command of its own the &#38; it produced would be decoded
# a second time. Everything else is left as it is.
decode_entities() {
  LC_ALL=C sed -E \
    -e 's/&lt;/</g'   -e 's/&#0*60;/</g' -e 's/&#[xX]0*3[cC];/</g' \
    -e 's/&gt;/>/g'   -e 's/&#0*62;/>/g' -e 's/&#[xX]0*3[eE];/>/g' \
    -e 's/&quot;/"/g' -e 's/&#0*34;/"/g' -e 's/&#[xX]0*22;/"/g' \
    -e "s/&apos;/'/g" -e "s/&#0*39;/'/g" -e "s/&#[xX]0*27;/'/g" \
    -e 's/&#0*35;/#/g' -e 's/&#[xX]0*23;/#/g' \
    -e 's/&#0*63;/?/g' -e 's/&#[xX]0*3[fF];/?/g' \
    -e 's/&#0*61;/=/g' -e 's/&#[xX]0*3[dD];/=/g' \
    -e 's/&(amp|#0*38|#[xX]0*26);/\&/g'
}

# bytes_match TEXT ERE: [[ TEXT =~ ERE ]], byte-wise. bash matches
# =~ in the caller's locale, and in a UTF-8 locale macOS bash 3.2 finds nothing
# in a text with a byte that is no UTF-8 (\377): /caf\377&#233; would escape the
# reference check and be fetched as the cut /caf\377&. Every =~ on text from
# the site goes through here, in a subshell with LC_ALL=C, so the locale of the
# run itself (${#text}, ${text:0:60} in log_text) is not touched.
bytes_match() (
  LC_ALL=C
  [[ $1 =~ $2 ]]
)

# undecoded WHAT ADDRESS: an address that still holds a character reference
# after decode_entities — a numeric one of any other character (&#233;, &#47;,
# &#x2F;) or a named one (&eacute;) — is a finding and is not fetched: reported
# (0) or not (1). Kirby's Xml::encode() writes every non-ASCII character as a
# numeric reference; curl reads the # of such a reference as the start of the
# fragment and requests a cut address (/blog&#47;neu becomes /blog&).
# Never a cut address, so the finding instead of a decoder for every character.
# The sitemap only: the homepage's parser decodes every reference.
reference_re='&(#[0-9]+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);'
undecoded() {
  local what=$1 address=$2
  if bytes_match "$address" "$reference_re"; then
    fail "$what with a character reference that is not decoded: $(log_text "$address") — not fetched"
    return 0
  fi
  return 1
}

# Unset GENBA_FOREIGN_SITEMAP: a preview (protected, with credentials) is the
# staging host whose site URL may be production, so its entries are rewritten;
# everywhere else a foreign entry means the site URL is wrong.
FOREIGN_DEFAULT=''
if [[ -z "$FOREIGN_MODE" ]]; then
  if [[ "$EXPECT_PROTECTED" == 1 || -n "$USER_NAME" ]]; then
    FOREIGN_MODE=rewrite
    FOREIGN_DEFAULT="GENBA_FOREIGN_SITEMAP not set: rewrite (a preview run: GENBA_EXPECT_PROTECTED=1 or GENBA_USER set)"
  else
    FOREIGN_MODE=fail
    FOREIGN_DEFAULT="GENBA_FOREIGN_SITEMAP not set: fail (not a preview run: neither GENBA_EXPECT_PROTECTED=1 nor GENBA_USER)"
  fi
fi
# Unset GENBA_CLOSED_PREVIEW: the same rule. A closed preview is what the Sudare
# package serves on purpose; on any other site it means the site is closed.
if [[ -z "$CLOSED_MODE" ]]; then
  if [[ "$EXPECT_PROTECTED" == 1 || -n "$USER_NAME" ]]; then
    CLOSED_MODE=accept
  else
    CLOSED_MODE=fail
  fi
fi

# --- curl ---------------------------------------------------------------------
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# --- the homepage reader ------------------------------------------------------
# bin/genba-smoke-read next to this script — the real file, not Composer's
# vendor/bin proxy (which execs this one) or a symbolic link to it.
self=${BASH_SOURCE[0]}
while [[ -L "$self" ]]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
READER="$(cd "$(dirname "$self")" && pwd -P)/genba-smoke-read"
# display_errors to stderr: a PHP error must never reach the records on stdout.
PHP_READ=(php -d display_errors=stderr "$READER")
if ! command -v php >/dev/null 2>&1; then
  cannot_run "php not found (genba-smoke reads the homepage with PHP: bin/genba-smoke-read)"
fi
# Before the first request: a missing mbstring or parser is an environment
# error, not a finding about the site.
reader_failed() {
  local reason
  reason=$(curl_error "$TMP/reader.err")
  cannot_run "$1${reason:-no reason given}"
}
if ! "${PHP_READ[@]}" --check 2> "$TMP/reader.err"; then
  reader_failed 'The homepage reader cannot run: '
fi

# A value in curl's config-file syntax: backslashes and double quotes escaped.
quote_config() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# -q must stay the FIRST argument: it stops curl from reading ~/.curlrc, where
# a verbose or trace setting would write the Authorization header to a log.
# -g: brackets and braces in a URL from the page are not curl ranges
# (/x[1-4].webp would otherwise become four requests, with credentials).
# --noproxy '*': no proxy from the environment (http_proxy, HTTPS_PROXY,
# ALL_PROXY), the same rule as genba-links' CURLOPT_PROXY ''. Behind a proxy
# the proxy resolves the name, so "does not resolve" (curl 6) never happens
# and a pending DNS entry would read as 14 findings with "Proxy CONNECT
# aborted"; and a proxy could redirect a request that carries credentials.
CURL_BASIC=(-q -g -sS --noproxy '*' --max-time "$MAX_TIME" --proto '=http,https')
CURL_OPTS=("${CURL_BASIC[@]}")
if [[ -n "$USER_NAME" ]]; then
  # The credentials go into a file that curl reads with -K, never onto a
  # command line, where every user on the machine could read them in ps.
  (
    umask 077
    printf 'user = "%s:%s"\n' "$(quote_config "$USER_NAME")" "$(quote_config "$PASSWORD")" > "$TMP/credentials.cfg"
  )
  CURL_OPTS+=(-K "$TMP/credentials.cfg")
fi

FAILED=0
fail() { echo "::error::$*"; FAILED=1; }
warn() { echo "::warning::$*"; }
ok() { echo "  ok   $*"; }
note() { echo "  --   $*"; }

# fetch METHOD URL FILE [MAX_BYTES] [HEADERS] -> sets CODE (HTTP status, 000 when there
# is none — or when curl did not finish the transfer), TYPE (lower-case media
# type without parameters), FETCH_RC (curl's exit code; 6 = the name does not
# resolve, 63 = the body is larger than MAX_BYTES — curl stopped, or the body
# on disk is larger — and must not be read) and
# FETCH_ERROR (curl's message as log text when the transfer failed, else
# empty). A status code curl printed for a transfer it could not finish proves
# nothing: after a 200 the connection may close with bytes missing
# (curl 18), time out before the body (28) or break (56) — then the body on
# disk is a cut one or none, so CODE is 000 and FILE is removed, never read.
# 63 is the one exception: the caller reads the size finding itself. Never -L:
# a redirect is a finding in itself, and credentials must never follow one.
# HEADERS: a file for the response headers (curl -D), so a caller reads a
# redirect's target from the same request instead of asking twice.
fetch() {
  local method=$1 target=$2 file=$3 max_bytes=${4:-} headers=${5:-} result ctype
  local -a limit=() dump=()
  if [[ -n "$max_bytes" ]]; then
    limit=(--max-filesize "$max_bytes")
  fi
  if [[ -n "$headers" ]]; then
    dump=(-D "$headers")
  fi
  FETCH_RC=0
  FETCH_ERROR=''
  # ${limit[@]+…}: an empty array counts as unbound (nounset) in bash 3.2.
  if [[ "$method" == HEAD ]]; then
    result=$(curl "${CURL_OPTS[@]}" ${limit[@]+"${limit[@]}"} ${dump[@]+"${dump[@]}"} -I -o "$file" -w '%{http_code}\t%{content_type}' "$target" 2>"$TMP/curl.err") || FETCH_RC=$?
  else
    result=$(curl "${CURL_OPTS[@]}" ${limit[@]+"${limit[@]}"} ${dump[@]+"${dump[@]}"} -o "$file" -w '%{http_code}\t%{content_type}' "$target" 2>"$TMP/curl.err") || FETCH_RC=$?
  fi
  # curl below 8.4 stops at --max-filesize only when the size is announced
  # (Content-Length); a body sent without one — chunked or over HTTP/2, as
  # PHP-FPM behind Apache or nginx sends a page — would be read to its end
  # (Ubuntu 22.04 has curl 7.81, Debian 12 7.88). The size on
  # disk is held against the limit too, so 63 means the same on every curl.
  if [[ -n "$max_bytes" && "$method" != HEAD ]] && (( FETCH_RC == 0 )) && [[ -f "$file" ]] \
    && (( $(wc -c < "$file" | tr -d ' ') > max_bytes )); then
    FETCH_RC=63
  fi
  if (( FETCH_RC == 26 )); then
    # curl could not read a local file, and the only one it is given is the
    # credentials file (-K): nothing was sent, and every further request would
    # fail the same way — not a finding about the site, the run cannot run.
    cannot_run "curl cannot read its credentials file (curl exit 26) — GENBA_USER/GENBA_PASSWORD were not sent; check them for characters curl's -K file cannot hold"
  fi
  CODE=${result%%$'\t'*}
  TYPE=''
  if [[ "$result" == *$'\t'* ]]; then
    ctype=${result#*$'\t'}
    ctype=${ctype%%;*}
    # The header comes from the site and is printed in findings: log text.
    TYPE=$(log_text "$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<<"$ctype" | LC_ALL=C tr -d ' ')")
  fi
  [[ -n "$CODE" ]] || CODE=000
  if (( FETCH_RC != 0 && FETCH_RC != 63 )); then
    CODE=000
    FETCH_ERROR=$(curl_error "$TMP/curl.err")
    rm -f "$file"
  fi
}

# origin_of URL -> its scheme://authority, normalised (normalize_origin). A
# value that is not an absolute URL comes back unchanged and matches nothing.
origin_of() {
  normalize_origin "$(LC_ALL=C sed -E 's|^([a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*).*|\1|' <<<"$1")"
}

# Same origin as the site? Only there do credentials go. Compared the way a
# browser does: case of scheme and host, and a default port, do not count.
same_origin() {
  [[ "$(origin_of "$1")" == "$ORIGIN_NORMALIZED" ]]
}

# on_own_origin URL -> the same path and query on the GENBA_URL origin, the
# fragment dropped: the rewrite of GENBA_FOREIGN_SITEMAP=rewrite, for sitemap
# entries and for the addresses of check 5.
on_own_origin() {
  local rest
  # '|' as the sed delimiter: '#' inside a bracket expression is not portable.
  rest=$(LC_ALL=C sed -E 's|^[a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*||; s|#.*||' <<<"$1")
  [[ "$rest" == /* ]] || rest="/$rest"
  printf '%s%s\n' "$ORIGIN" "$rest"
}

# add_asset URL: an address of check 5 (homepage or stylesheet) for the list
# of files to check. On a rewrite run with
# GENBA_SITEMAP_ORIGIN, an address on that origin — a staging host whose site
# URL is production writes <link href="https://prod…/assets/css/…"> — is the
# same path on the own origin, as the sitemap's entries are; it is noted in
# assets-rewritten.txt for the notice. Only that declared origin: any other
# (a CDN) is never rewritten.
add_asset() {
  if [[ "$FOREIGN_MODE" == rewrite && -n "$SITEMAP_ORIGIN" && "$(origin_of "$1")" == "$SITEMAP_ORIGIN_NORMALIZED" ]]; then
    on_own_origin "$1" >> "$TMP/assets.txt"
    printf '%s\n' "$1" >> "$TMP/assets-rewritten.txt"
  else
    printf '%s\n' "$1" >> "$TMP/assets.txt"
  fi
}

# not_ready CODE RC ERRFILE: is the host not ready yet? The name does not
# resolve (curl exit 6), or the https connection fails while http answers (the
# TLS certificate is not issued yet). With GENBA_NOT_READY=skip either ends the
# run as SKIPPED, exit 0, never as PASSED. With fail (default) a name that does
# not resolve ends it as FAILED, and a failed https connection is left to the
# checks. Called ONCE, on the first request of the run (the gate's, without
# credentials, when it runs): a later request that fails is a finding, never a
# reason to skip — a site that answers 401 at once and then hangs behind the
# protection is broken, not pending.
# Port of the preview workflow's reachability gate (kirby-starter).
not_ready() {
  local code=$1 rc=$2 errfile=$3 plain_url plain
  if (( rc == 6 )); then
    if [[ "$NOT_READY_MODE" == skip ]]; then
      warn "Genba smoke: SKIPPED — $HOST does not resolve yet (DNS entry pending). Nothing was checked; run again once the name resolves."
      echo "Genba smoke: SKIPPED — $HOST does not resolve yet"
      exit 0
    fi
    fail "$HOST does not resolve (DNS entry missing?) — a preview whose DNS entry is still pending sets GENBA_NOT_READY=skip"
    echo "Genba smoke: FAILED — see findings above."
    exit 1
  fi
  if [[ "$code" == 000 && "$URL" == https://* && "$NOT_READY_MODE" == skip ]]; then
    # Only a connection that cannot be set up counts: refused (7), TLS
    # handshake or certificate errors (35 51 58 59 60 77 83 90 91). A timeout
    # (28), an empty answer (52) or a broken transfer (56) means the server is
    # there and fails — a finding. So does an expired certificate: it was
    # issued once, nothing is pending.
    case "$rc" in
      7|35|51|58|59|60|77|83|90|91) ;;
      *) return 0 ;;
    esac
    if LC_ALL=C grep -qi 'certificate has expired' "$errfile" 2>/dev/null; then
      return 0
    fi
    # The name resolves, but no https connection: is plain http there? No
    # credentials on this request — they never travel over http.
    plain_url=${GENBA_HTTP_URL:-http://$HOST/}
    plain=$(curl "${CURL_BASIC[@]}" -o /dev/null -w '%{http_code}' "$plain_url" 2>/dev/null || true)
    [[ -n "$plain" ]] || plain=000
    if [[ "$plain" == 000 ]]; then
      return 0
    fi
    if [[ "$EXPECT_PROTECTED" == 1 && "$plain" != 401 ]]; then
      fail "https to $HOST fails, and without credentials $plain_url returns HTTP $plain instead of 401 — the preview protection does not work, the site may be open to everyone"
      echo "Genba smoke: FAILED — see findings above."
      exit 1
    fi
    warn "Genba smoke: SKIPPED — https to $HOST fails, but $plain_url answers HTTP $plain: TLS certificate not issued yet? Nothing was checked."
    echo "Genba smoke: SKIPPED — https to $HOST fails (certificate pending?)"
    exit 0
  fi
  return 0
}

# Every grep on a fetched body runs with -a: a NUL byte in a page
# makes GNU grep print nothing on stdout ("binary file matches" on stderr) and
# BSD grep answer "Binary file … matches" instead of the match — even -q fails
# on macOS — so a page with a NUL would read as "without <meta>", "marker missing",
# "no stylesheet found", "Sitemap lists no pages": loud, with the wrong cause.
# -a treats the body as text; the control characters are dropped later anyway.

# strip_comments: the sed command that drops every <!-- … --> of the flattened
# sitemap (a commented-out sitemap entry is no entry: never counted, never
# fetched; the homepage is read by an HTML5 parser, read_homepage). A
# comment ends at the first -->: its content holds no "-->", but may hold a
# single "-" or "--" (HTML is lenient; XML forbids "--"), and "--->" closes it
# too. An unterminated <!-- is left as it is. Bodies on one line: the comment
# may span what were several lines.
strip_comments='s/<!--([^-]|-[^-]|--+[^->])*--+>//g'

# read_homepage FILE TEXT RECORDS: the saved homepage FILE, read.
# TEXT: the body on one line, nothing dropped (line breaks and tabs become
# spaces, a CR is dropped) — the marker is looked for there, anywhere in the
# HTML, comments and scripts included (a marker like <!-- example --> is common).
# RECORDS: what the page holds, one record per line, the kind, a tab, the value
# — build (the <meta name="$META">), base, link (stylesheet or preload), src,
# srcset (each candidate) — as bin/genba-smoke-read reads it with an HTML5
# parser (src/Homepage.php): as the browser's tokenizer and tree builder do, so
# comments, <script>, <style>, RCDATA in <title> and <textarea>, end tags with
# attributes, bogus comments, <template>, <svg> and <math> are what they are
# for the browser — a reader made of awk and grep gets one spelling or another
# wrong (SPEC decision 24). Every value is log text
# already (the reader percent-encodes control characters as encode_controls
# does), and
# every character reference is decoded, as the browser decodes it. A missing
# FILE (fetch() removed a cut body) gives an empty TEXT and RECORDS. A reader
# that fails is "cannot run": nothing of the page could be checked. The reader
# runs at most GENBA_MAX_TIME seconds: Lexbor needs
# time quadratic in the depth of nesting (80 000 nested <div> took 16 s), and
# PHP's max_execution_time does not reach into it — so a watchdog stops it,
# and that is "cannot run" too, never a run that hangs until the job's limit.
read_homepage() {
  local reader_pid watch_pid reader_rc=0
  : > "$2"
  : > "$3"
  if [[ -f "$1" ]]; then
    LC_ALL=C tr -d '\r' < "$1" | LC_ALL=C tr '\n\t' '  ' > "$2"
    rm -f "$TMP/reader.timeout"
    "${PHP_READ[@]}" --meta="$META" "$1" > "$3" 2> "$TMP/reader.err" &
    reader_pid=$!
    reader_watch "$reader_pid" "$MAX_TIME" </dev/null >/dev/null 2>&1 &
    watch_pid=$!
    wait "$reader_pid" 2>/dev/null || reader_rc=$?
    kill "$watch_pid" 2>/dev/null || true
    wait "$watch_pid" 2>/dev/null || true
    if [[ -e "$TMP/reader.timeout" ]]; then
      cannot_run "The homepage cannot be read: the reader did not finish within $MAX_TIME seconds (GENBA_MAX_TIME)"
    fi
    if (( reader_rc != 0 )); then
      reader_failed 'The homepage cannot be read: '
    fi
  fi
}

# reader_watch PID SECONDS: the watchdog of read_homepage, run in the
# background with its output on /dev/null (a sleep that outlives the run must
# not hold the caller's pipe open). After SECONDS it marks the timeout and
# stops PID; stopped itself (TERM) it stops its own sleep first.
reader_watch() {
  local sleeper=''
  trap 'kill "$sleeper" 2>/dev/null; exit 0' TERM
  sleep "$2" &
  sleeper=$!
  wait "$sleeper"
  : > "$TMP/reader.timeout"
  kill "$1" 2>/dev/null
}

# resolve BASE REFERENCE -> absolute URL without fragment. Resolves ./ and ../
# in the path; the query string (?v=…) is kept as it is. A reference with a
# scheme is absolute, the scheme in any case (HTTPS://cdn… is no path on the
# own origin, to be requested there) — byte-wise, it is page text
# (bytes_match).
resolve() {
  local base=$1 ref=${2%%#*} origin path query=''
  if bytes_match "$ref" '^[A-Za-z][A-Za-z0-9+.-]*://'; then
    printf '%s\n' "$ref"
    return 0
  fi
  case "$ref" in
    //*) printf '%s%s\n' "${base%%//*}" "$ref"; return 0 ;;
  esac
  origin=$(LC_ALL=C sed -E 's#^([a-zA-Z]+://[^/]+).*#\1#' <<<"$base")
  if [[ "$ref" == /* ]]; then
    path=$ref
  else
    path=$(LC_ALL=C sed -E 's#^[a-zA-Z]+://[^/]+##; s#[?].*##; s#[^/]*$##' <<<"$base")$ref
  fi
  if [[ "$path" == *\?* ]]; then
    query="?${path#*\?}"
    path=${path%%\?*}
  fi
  path=$(LC_ALL=C awk -F/ '{ n = 0; for (i = 2; i <= NF; i++) { if ($i == "..") { if (n > 0) n--; } else if ($i != ".") a[++n] = $i } s = ""; for (i = 1; i <= n; i++) s = s "/" a[i]; if (s == "") s = "/"; print s }' <<<"$path")
  printf '%s%s%s\n' "$origin" "$path" "$query"
}

# redirect_location HEADERS -> the target of a redirect as the server sent it:
# the last Location header, else the target of a Refresh header ("0; url=…").
# That target starts right after the url= that follows the seconds and runs to
# the end, quotes around it dropped — an url= in its query is part of it.
redirect_location() {
  local location
  location=$(LC_ALL=C grep -ai '^location:' "$1" | tail -n 1 | LC_ALL=C tr -d '\r' \
    | LC_ALL=C sed 's/^[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:[[:space:]]*//' || true)
  if [[ -z "$location" ]]; then
    location=$(LC_ALL=C grep -ai '^refresh:' "$1" | tail -n 1 | LC_ALL=C tr -d '\r' \
      | LC_ALL=C sed -n -E 's/^[Rr][Ee][Ff][Rr][Ee][Ss][Hh]:[[:space:]]*[0-9.]*[[:space:]]*[;,]?[[:space:]]*([Uu][Rr][Ll][[:space:]]*=[[:space:]]*)?//p' || true)
    case "$location" in
      \"*) location=${location#\"}; location=${location%%\"*} ;;
      \'*) location=${location#\'}; location=${location%%\'*} ;;
    esac
  fi
  printf '%s\n' "$location"
}

# expected_type URL -> the Content-Type an asset of that kind must have.
expected_type() {
  case "$(LC_ALL=C sed -E 's#[?].*##' <<<"$1" | LC_ALL=C tr '[:upper:]' '[:lower:]')" in
    *.webp) echo image/webp ;;
    *.avif) echo image/avif ;;
    *.woff2) echo font/woff2 ;;
  esac
}

# robots_disallows_all FILE: 0 when FILE holds a User-agent: * line and Disallow: /
# and nothing else but a Sitemap line, comments and blank lines. Any other rule
# (an Allow, a Disallow of one path, another User-agent) makes it 1.
robots_disallows_all() {
  LC_ALL=C tr -d '\r' < "$1" | LC_ALL=C awk '
    { sub(/#.*/, ""); gsub(/^[ \t]+|[ \t]+$/, "") }
    $0 == "" { next }
    tolower($0) ~ /^user-agent:[ \t]*\*$/ { ua = 1; next }
    tolower($0) ~ /^disallow:[ \t]*\/$/ { dis = 1; next }
    tolower($0) ~ /^sitemap:[ \t]*[^ \t]/ { next }
    { other = 1 }
    END { exit !(ua && dis && !other) }'
}

# sitemap_has_entries: 0 when the sitemap body names a <url> or a <loc> element
# (comments aside). An empty <urlset> names none; a prefixed <sm:url> counts too.
sitemap_has_entries() {
  LC_ALL=C tr -d '\n\r' < "$TMP/sitemap.xml" \
    | LC_ALL=C sed -E "$strip_comments" \
    | LC_ALL=C grep -aqE '<([A-Za-z_][A-Za-z0-9_.-]*:)?(url|loc)[[:space:]/>]'
}

# check_file PATH TYPES PATTERN [MAX_BYTES]: GET and HEAD must answer 200 with
# one of the types (separated by |), and the GET body must match the pattern.
# The body is fetched ONCE and kept as $TMP/PATH for the checks that follow —
# a second GET could answer differently (500, timeout) and, unread, would pass
# the pattern and the sitemap check without a word. With MAX_BYTES a larger
# body is a finding and is not read.
check_file() {
  local path=$1 types=$2 pattern=$3 max_bytes=${4:-} method file expected get_code=000
  rm -f "$TMP/$path"
  for method in GET HEAD; do
    file=$TMP/head
    if [[ "$method" == GET ]]; then
      file=$TMP/$path
    fi
    fetch "$method" "$URL/$path" "$file" "$max_bytes"
    if [[ "$method" == GET && "$FETCH_RC" == 63 ]]; then
      # Larger than MAX_BYTES (curl stopped at --max-filesize, or an older curl
      # read it all): the body is removed, never read.
      rm -f "$file"
      fail "GET /$path: larger than $max_bytes bytes — not read"
      continue
    fi
    if [[ "$method" == GET ]]; then
      get_code=$CODE
    fi
    if [[ "$CODE" != 200 ]]; then
      fail "$method /$path: HTTP $CODE instead of 200$(fetch_detail)"
    elif [[ "|$types|" != *"|$TYPE|"* ]]; then
      expected=${types//|/ or }
      fail "$method /$path: Content-Type '$TYPE', expected $expected"
    else
      ok "$method /$path: 200, $TYPE"
    fi
  done
  CHECK_GET_CODE=$get_code
  if [[ "$get_code" == 200 && -n "$pattern" ]] && ! LC_ALL=C grep -aqE -- "$pattern" "$TMP/$path"; then
    fail "/$path does not contain what it should (pattern: $pattern)"
  fi
}

echo "Genba smoke against $URL, expected build $EXPECTED"
if [[ -n "$FOREIGN_DEFAULT" ]]; then
  note "$FOREIGN_DEFAULT"
fi

# 0. Reachability gate: protection proven without credentials ------------------
# A protected preview must answer 401 to a request WITHOUT credentials; a 200
# means the protection is off and the site is open to everyone. This is the
# first request, so a name that does not resolve yet is caught here too.
if [[ "$EXPECT_PROTECTED" == 1 ]]; then
  probe_rc=0
  probe=$(curl "${CURL_BASIC[@]}" -o /dev/null -w '%{http_code}' "$URL/" 2>"$TMP/probe.err") || probe_rc=$?
  [[ -n "$probe" ]] || probe=000
  not_ready "$probe" "$probe_rc" "$TMP/probe.err"
  if [[ "$probe" == 401 ]]; then
    ok "Protected: $URL/ answers 401 without credentials"
  elif [[ "$probe" == 000 ]]; then
    detail=$(curl_error "$TMP/probe.err")
    if [[ -n "$detail" ]]; then
      detail=" — $detail"
    fi
    fail "Without credentials $URL/ gives no answer (HTTP 000)$detail — the preview protection is not verified"
  else
    fail "Without credentials $URL/ returns HTTP $probe instead of 401 — the preview protection does not work, the site may be open to everyone"
  fi
fi

# 1. Homepage: build and marker ------------------------------------------------
STAND=''
HOME_TOO_LARGE=0
for ((attempt = 1; attempt <= RETRIES; attempt++)); do
  fetch GET "$URL/" "$TMP/start.html" "$BODY_MAX_BYTES"
  # Not ready is decided once: by the gate when it ran, else here.
  if (( attempt == 1 )) && [[ "$EXPECT_PROTECTED" != 1 ]]; then
    not_ready "$CODE" "$FETCH_RC" "$TMP/curl.err"
  fi
  if [[ "$FETCH_RC" == 63 ]]; then
    # Larger than BODY_MAX_BYTES (also when an older curl read it all):
    # nothing of the body is read, and another attempt would
    # fetch the same size.
    rm -f "$TMP/start.html"
    : > "$TMP/start.text"
    : > "$TMP/home.txt"
    HOME_TOO_LARGE=1
    STAND=''
    break
  fi
  # The records of the page (check 5 reads the same file).
  read_homepage "$TMP/start.html" "$TMP/start.text" "$TMP/home.txt"
  STAND=$(LC_ALL=C awk -F '\t' '$1 == "build" { print $2; exit }' "$TMP/home.txt")
  # Prefix match: GENBA_EXPECTED_BUILD may be an abbreviated hash (7–64 digits).
  if [[ "$CODE" == 200 && "$STAND" == "$EXPECTED"* ]]; then
    break
  fi
  # A 401 is not a cache that still holds the old build: waiting changes nothing.
  if [[ "$CODE" == 401 ]]; then
    break
  fi
  if (( attempt < RETRIES )); then
    sleep "$PAUSE"
  fi
done

if [[ "$CODE" == 401 && -z "$USER_NAME" && "$CREDENTIALS_MODE" == skip ]]; then
  if (( FAILED != 0 )); then
    # The gate already has a finding (no answer, or a code other than 401): a
    # run with findings is never SKIPPED, whatever else is missing.
    note "$URL requires credentials (HTTP 401) and GENBA_USER/GENBA_PASSWORD are not set — not SKIPPED: the run has findings already"
    echo "Genba smoke: FAILED — see findings above."
    exit 1
  fi
  warn "Genba smoke: SKIPPED — $URL requires credentials (HTTP 401) and GENBA_USER/GENBA_PASSWORD are not set. Whether the new build arrived is NOT verified."
  # SPEC §3.0: the last line of a skipped run starts with "Genba smoke: SKIPPED".
  echo "Genba smoke: SKIPPED — build not verified, see the warning above."
  exit 0
fi

HOME_CODE=$CODE
if (( HOME_TOO_LARGE )); then
  fail "Homepage larger than $BODY_MAX_BYTES bytes — not read: its build, its marker and its addresses are not checked"
elif [[ "$CODE" != 200 ]]; then
  hint=''
  if [[ "$CODE" == 401 && -z "$USER_NAME" ]]; then
    hint=' (protected: set GENBA_USER and GENBA_PASSWORD)'
  fi
  fail "Homepage: HTTP $CODE instead of 200$hint$(fetch_detail)"
elif [[ -z "$STAND" ]]; then
  fail "Homepage without <meta name=\"$META\"> — stamp file not deployed or snippet('genba/stamp') missing in <head>"
elif [[ "$STAND" != "$EXPECTED"* ]]; then
  # The reader admits hex digits only, but any number of them: log text.
  fail "Live build is $(log_text "$STAND"), expected $EXPECTED — the upload did not (fully) arrive"
else
  ok "Homepage serves build $(log_text "$STAND")"
fi

if [[ -z "$MARKER" ]]; then
  note "marker not checked (GENBA_MARKER empty)"
elif [[ "$CODE" == 200 ]] && (( ! HOME_TOO_LARGE )); then
  # Anywhere in the HTML, comments and scripts included.
  if LC_ALL=C grep -aqF -- "$MARKER" "$TMP/start.text"; then
    ok "Marker '$MARKER' found"
  else
    fail "Homepage does not contain the marker '$MARKER' — is this really our site?"
  fi
fi

# 2. Unknown address -> 404 ----------------------------------------------------
fetch GET "$URL/genba-smoke-does-not-exist-$$-$RANDOM" "$TMP/404.html"
if [[ "$CODE" == 404 ]]; then
  ok "Unknown address returns 404"
else
  fail "Unknown address returns HTTP $CODE instead of 404$(fetch_detail)"
fi

# 3. robots.txt, sitemap.xml, llms.txt per GET and HEAD -------------------------
check_file robots.txt 'text/plain' ''
ROBOTS_GET_CODE=$CHECK_GET_CODE
check_file sitemap.xml 'application/xml|text/xml' '<urlset' "$BODY_MAX_BYTES"
SITEMAP_GET_CODE=$CHECK_GET_CODE
check_file llms.txt 'text/plain|text/markdown' '^# '

# 3b. A closed preview (GENBA_CLOSED_PREVIEW=accept) ------------------------------
# The Sudare package serves robots.txt as Disallow: / without a Sitemap line, and
# sitemap.xml as an empty <urlset>, on purpose. Only that combination is accepted:
# Disallow: / with pages in the sitemap would close the live site by mistake, and
# an empty sitemap with an open robots.txt stays a finding.
CLOSED=0
if [[ "$CLOSED_MODE" == accept && "$ROBOTS_GET_CODE" == 200 && "$SITEMAP_GET_CODE" == 200 ]] \
  && [[ -f "$TMP/robots.txt" && -f "$TMP/sitemap.xml" ]] \
  && robots_disallows_all "$TMP/robots.txt" && LC_ALL=C grep -aq '<urlset' "$TMP/sitemap.xml"; then
  if sitemap_has_entries; then
    fail "robots.txt disallows all crawling (Disallow: /) but the sitemap lists pages — the live site would be closed by mistake (GENBA_CLOSED_PREVIEW=accept accepts Disallow: / only with an empty sitemap)"
  else
    CLOSED=1
  fi
fi
# The pattern of check 3, for a robots.txt that is not the closed one.
if [[ "$ROBOTS_GET_CODE" == 200 ]] && (( ! CLOSED )) && ! LC_ALL=C grep -aqE -- '^Sitemap: ' "$TMP/robots.txt"; then
  fail "/robots.txt does not contain what it should (pattern: ^Sitemap: )"
fi

# 4. Every page of the sitemap -------------------------------------------------
# The body of the one GET above. Missing or without <urlset> (the finding is
# already printed), the pages cannot be checked — said out loud, never skipped.
if (( CLOSED )); then
  note "closed preview: robots.txt Disallow: / and an empty sitemap, so no sitemap pages were fetched (GENBA_CLOSED_PREVIEW=accept)"
elif [[ ! -s "$TMP/sitemap.xml" ]] || ! LC_ALL=C grep -aq '<urlset' "$TMP/sitemap.xml"; then
  fail "Sitemap not available for page check"
else
  # A pretty-printed sitemap puts the address on its own line, some generators
  # wrap it in CDATA: the body is flattened to one line, CDATA directly inside
  # <loc> is unwrapped and whitespace around the address dropped before the
  # entries are cut out — the grep below would otherwise skip them without a
  # word. Entries it still cannot read are counted against the <url>
  # elements and reported, never dropped silently. Comments go first:
  # a commented-out <url> is no entry, never counted and never fetched.
  LC_ALL=C tr -d '\n\r' < "$TMP/sitemap.xml" \
    | LC_ALL=C sed -E -e "$strip_comments" -e 's#<loc>[[:space:]]*<!\[CDATA\[#<loc>#g' -e 's#\]\]>[[:space:]]*</loc>#</loc>#g' \
             -e 's#<loc>[[:space:]]+#<loc>#g' -e 's#[[:space:]]+</loc>#</loc>#g' > "$TMP/sitemap.flat"
  LC_ALL=C grep -ao '<loc>[^<]*</loc>' "$TMP/sitemap.flat" > "$TMP/locs.txt" || true
  url_count=$({ LC_ALL=C grep -ao '<url>' "$TMP/sitemap.flat" || true; } | wc -l | tr -d ' ')
  loc_count=$(wc -l < "$TMP/locs.txt" | tr -d ' ')
  if (( url_count != loc_count )); then
    unparsed=$(( url_count > loc_count ? url_count - loc_count : loc_count - url_count ))
    fail "Sitemap: $unparsed entries could not be parsed ($url_count <url> entries, $loc_count <loc> addresses)"
  fi
  if [[ ! -s "$TMP/locs.txt" ]]; then
    fail "Sitemap lists no pages"
  else
    # The generator wrote the URL with htmlspecialchars(ENT_XML1): the entities
    # are decoded (decode_entities), control characters percent-encoded as the
    # URL parser does (encode_controls): a <loc> is
    # printed in findings, and an ESC in it would rewrite the log line.
    # The first GENBA_PAGES_MAX entries; the ok line below says when there were more.
    LC_ALL=C sed -E -e 's#</?loc>##g' "$TMP/locs.txt" | decode_entities | encode_controls | head -n "$PAGES_MAX" > "$TMP/pages.txt" || true
    # Each line of fetch.txt: the address to fetch, a tab, and the address the
    # sitemap listed when it was rewritten (empty otherwise).
    : > "$TMP/fetch.txt"
    : > "$TMP/foreign.txt"
    rewritten=0
    foreign_skipped=0
    while IFS= read -r page; do
      # An entry that is empty after decoding and filtering (<loc></loc>, whitespace
      # only, control characters only) is a finding of its own; the
      # <url>/<loc> count does not catch it, the element is there.
      if [[ -z "$page" ]]; then
        fail "Sitemap entry is empty (<loc> without an address)"
        continue
      fi
      if too_long "Sitemap entry" "$page"; then
        continue
      fi
      if undecoded "Sitemap entry" "$page"; then
        continue
      fi
      # The sitemap protocol requires the full address. A relative entry
      # (/kontakt) has no origin: it would read as "foreign host" in fail mode and
      # be fetched on $ORIGIN without a word in rewrite mode.
      if ! bytes_match "$page" '^[a-zA-Z][a-zA-Z0-9+.-]*://'; then
        fail "Sitemap entry is not an absolute URL: $page — the sitemap protocol requires scheme and host"
        continue
      fi
      if same_origin "$page"; then
        printf '%s\t\n' "$page" >> "$TMP/fetch.txt"
        continue
      fi
      page_origin=$(origin_of "$page")
      if [[ -n "$SITEMAP_ORIGIN" && "$page_origin" != "$SITEMAP_ORIGIN_NORMALIZED" ]]; then
        # Only the declared production origin is expected; a third one is
        # never rewritten, whatever the mode.
        fail "Sitemap points to a foreign host: $page (neither $ORIGIN nor GENBA_SITEMAP_ORIGIN $SITEMAP_ORIGIN)"
        continue
      fi
      if [[ "$FOREIGN_MODE" == rewrite ]]; then
        # Staging whose site URL is production lists production addresses: the
        # same path and query are fetched on the GENBA_URL origin instead. Only
        # there do credentials go, as for every other request.
        printf '%s\t%s\n' "$(on_own_origin "$page")" "$page" >> "$TMP/fetch.txt"
        printf '%s\n' "$page_origin" >> "$TMP/foreign.txt"
        rewritten=$((rewritten + 1))
      elif [[ "$FOREIGN_MODE" == warn ]]; then
        warn "Sitemap points to a foreign host: $page (site URL misconfigured?)"
        foreign_skipped=$((foreign_skipped + 1))
      else
        fail "Sitemap points to a foreign host: $page (site URL misconfigured?)"
      fi
    done < "$TMP/pages.txt"
    if (( rewritten > 0 )); then
      foreign_origins=$(LC_ALL=C sort -u "$TMP/foreign.txt" | LC_ALL=C paste -s -d ',' - | LC_ALL=C sed 's/,/, /g')
      echo "::notice::Sitemap lists $rewritten pages on $foreign_origins instead of $ORIGIN — rewritten to $ORIGIN (path and query kept) and fetched there (GENBA_FOREIGN_SITEMAP=rewrite)"
    fi
    fetched=0
    while IFS=$'\t' read -r page listed; do
      [[ -n "$page" ]] || continue
      fetch GET "$page" "$TMP/page.html"
      fetched=$((fetched + 1))
      if [[ "$CODE" != 200 ]]; then
        if [[ -n "$listed" ]]; then
          fail "Sitemap page $page: HTTP $CODE instead of 200 (listed as $listed)$(fetch_detail)"
        else
          fail "Sitemap page $page: HTTP $CODE instead of 200$(fetch_detail)"
        fi
      fi
    done < "$TMP/fetch.txt"
    if (( fetched == 0 && foreign_skipped > 0 )); then
      # Every entry was foreign (warn mode): nothing of this site was fetched,
      # and "0 pages fetched" must not read as a pass.
      warn "No sitemap page fetched: the entries point to a foreign host — the pages of $URL are NOT checked"
    elif (( fetched == 0 )); then
      # No foreign entry was skipped, so every entry is a finding above (empty,
      # relative, too long, foreign in fail mode). Said once more as a finding of
      # its own, without guessing a cause such as "foreign host" — a count of
      # zero must never pass.
      fail "No sitemap page fetched: every entry is a finding (see above) — the pages of $URL are NOT checked"
    elif (( loc_count > PAGES_MAX )); then
      # head -n cut the list: said here, so "1 sitemap pages fetched" never reads
      # as "the sitemap has one page".
      ok "$fetched of $loc_count sitemap pages fetched (GENBA_PAGES_MAX=$PAGES_MAX), the rest not checked"
    else
      ok "$fetched sitemap pages fetched"
    fi
  fi
fi

# 5. Stylesheets, then fonts and images from the homepage and the stylesheets ---
: > "$TMP/assets.txt"
: > "$TMP/assets-rewritten.txt"
# Only a homepage that was read names addresses: a page too large or not 200
# is said once, with its reason — three lines "no .webp file found on the
# homepage" would name the wrong cause.
# The finding about the homepage stands above; as check 8 does.
HOME_READ=0
if (( HOME_TOO_LARGE )); then
  note "stylesheets, images and fonts not checked: the homepage is larger than $BODY_MAX_BYTES bytes and was not read"
elif [[ "$HOME_CODE" == 000 ]]; then
  note "stylesheets, images and fonts not checked: the homepage gave no answer (HTTP 000)"
elif [[ "$HOME_CODE" != 200 ]]; then
  note "stylesheets, images and fonts not checked: the homepage answered HTTP $HOME_CODE, not 200"
else
  HOME_READ=1
fi
if (( HOME_READ )) && [[ -s "$TMP/start.html" ]]; then
  # The addresses the reader found (read_homepage): the href of every
  # <link> whose rel holds the token stylesheet or preload, every src, every
  # candidate of every srcset, in the order of the elements — decoded, trimmed
  # and free of control characters already. Only srcset is split at commas:
  # src="data:,x.webp" is one address, not a request for /x.webp.
  # The kind of an address is read from it below, without regard to case.
  # A <base href>: the relative addresses are resolved against it,
  # as the browser does — said in a -- line. In document order: what stands
  # before the <base> is resolved against the page's own address, the browser
  # fetches it before the base is there. A data: or
  # javascript: base is ignored, as the browser ignores it ("set the frozen
  # base URL"); any other base that is no http(s) address
  # (mailto:, about:) is a finding: the browser resolves nothing against it.
  home_base="$URL/"
  base_ok=1
  while IFS=$'\t' read -r kind ref; do
    if [[ "$kind" == base ]]; then
      if ! bytes_match "$ref" '^[A-Za-z][A-Za-z0-9+.-]*:' || bytes_match "$ref" '^[Hh][Tt][Tt][Pp][Ss]?://'; then
        home_base=$(resolve "$URL/" "$ref")
        note "<base href=\"$(log_text "$ref")\"> on the homepage: the addresses after it are resolved against $(log_text "$home_base")"
      elif bytes_match "$ref" '^([Dd][Aa][Tt][Aa]|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]):'; then
        note "<base href=\"$(log_text "$ref")\"> on the homepage is ignored, as the browser ignores a data: or javascript: base"
      else
        fail "Homepage <base href=\"$(log_text "$ref")\"> is no http(s) address — the addresses after it are not checked"
        base_ok=0
      fi
      continue
    fi
    [[ "$kind" == link || "$kind" == src || "$kind" == srcset ]] || continue
    (( base_ok )) || continue
    # A data: URI holds no address; its scheme in any case.
    [[ -n "$ref" ]] || continue
    case "$ref" in [Dd][Aa][Tt][Aa]:*) continue ;; esac
    add_asset "$(resolve "$home_base" "$ref")"
  done < "$TMP/home.txt"

  # The kind is read without regard to case, here as in the asset loop below:
  # /X.CSS is a stylesheet.
  LC_ALL=C grep -iE '\.css(\?|$)' "$TMP/assets.txt" | LC_ALL=C sort -u > "$TMP/css.txt" || true
  stylesheets=0
  : > "$TMP/css-own.txt"
  while IFS= read -r css; do
    same_origin "$css" || continue
    stylesheets=$((stylesheets + 1))
    printf '%s\n' "$css" >> "$TMP/css-own.txt"
    if too_long "Stylesheet address" "$css"; then
      continue
    fi
    # A fresh file per fetch: a request that fails leaves no body behind, and
    # the byte count below must not be the previous stylesheet's.
    rm -f "$TMP/style.css"
    fetch GET "$css" "$TMP/style.css"
    bytes=0
    if [[ -f "$TMP/style.css" ]]; then
      bytes=$(wc -c < "$TMP/style.css" | tr -d ' ')
    fi
    if [[ "$CODE" != 200 || "$TYPE" != text/css || ! -s "$TMP/style.css" ]]; then
      fail "Stylesheet $css: HTTP $CODE, '$TYPE', $bytes bytes — expected 200, text/css, not empty$(fetch_detail)"
      continue
    fi
    ok "Stylesheet: 200, text/css"
    LC_ALL=C grep -aoE 'url\([^)]+\)' "$TMP/style.css" \
      | LC_ALL=C sed -E -e 's/^url\(//' -e 's/\)$//' -e 's/^["'\'']//' -e 's/["'\'']$//' | encode_controls > "$TMP/cssrefs.txt" || true
    while IFS= read -r ref; do
      case "$ref" in ''|[Dd][Aa][Tt][Aa]:*) continue ;; esac
      add_asset "$(resolve "$css" "$ref")"
    done < "$TMP/cssrefs.txt"
  done < "$TMP/css.txt"
  if [[ -s "$TMP/assets-rewritten.txt" ]]; then
    rewritten_assets=$(LC_ALL=C sort -u "$TMP/assets-rewritten.txt" | wc -l | tr -d ' ')
    echo "::notice::The homepage and its stylesheets name $rewritten_assets addresses on $SITEMAP_ORIGIN instead of $ORIGIN — rewritten to $ORIGIN (path and query kept) and checked there (GENBA_FOREIGN_SITEMAP=rewrite, GENBA_SITEMAP_ORIGIN)"
  fi
  if (( stylesheets == 0 )); then
    note "no stylesheet of $ORIGIN found on the homepage, stylesheets not checked"
  fi
  # The safety net under the reader (SPEC §3.0 "no silent passes").
  # A reader error that loses a <link> ends in "no stylesheet", only a -- line:
  # the run would pass with the stylesheet unchecked, a 404 one
  # too. The marker names the stylesheet by default (assets/css/tailwind.css).
  # When it is a .css address and stands in the page, the page names its
  # stylesheet — then a stylesheet of the own origin with that address must be
  # among those read from the <link> elements, else that is a finding: the
  # check did not run, whatever the cause (the reader, a stylesheet loaded by a
  # script or from another origin). A finding, not a warning: a warning leaves
  # the run green, and that is the silent pass this net is for. A site whose
  # stylesheet is not in a <link> of its own origin sets GENBA_MARKER to
  # another text (or empty) and the net is off.
  marker_lower=$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<<"$MARKER")
  if [[ "$HOME_CODE" == 200 && "$marker_lower" == *.css ]] && LC_ALL=C grep -aqF -- "$MARKER" "$TMP/start.text" \
    && ! LC_ALL=C grep -qiF -- "$MARKER" "$TMP/css-own.txt"; then
    fail "Homepage contains the stylesheet address '$MARKER' (GENBA_MARKER), but no stylesheet of $ORIGIN with that address was read from its <link> elements — the stylesheet is not checked (loaded by a script, from another origin, or read wrongly?)"
  fi
fi

# Up to five per type: it is the server configuration that is tested, not
# every single file.
for ext in webp avif woff2; do
  (( HOME_READ )) || break
  LC_ALL=C grep -iE "\\.${ext}(\\?|\$)" "$TMP/assets.txt" | LC_ALL=C sort -u > "$TMP/typ-all.txt" || true
  # Own origin first, then the five: five foreign files must not crowd out the
  # own ones and leave nothing checked without a word.
  : > "$TMP/typ.txt"
  foreign=0
  while IFS= read -r asset; do
    if same_origin "$asset"; then
      printf '%s\n' "$asset" >> "$TMP/typ.txt"
    else
      foreign=$((foreign + 1))
    fi
  done < "$TMP/typ-all.txt"
  if [[ ! -s "$TMP/typ.txt" ]]; then
    if (( foreign > 0 )); then
      note "no .$ext file of $ORIGIN found on the homepage ($foreign on other origins, not requested), Content-Type not checked"
    else
      note "no .$ext file found on the homepage, Content-Type not checked"
    fi
    continue
  fi
  own_count=$(wc -l < "$TMP/typ.txt" | tr -d ' ')
  if (( own_count > 5 )); then
    note "$own_count .$ext files of $ORIGIN on the homepage, the first 5 checked (the server configuration is tested, not every file)"
  fi
  head -n 5 "$TMP/typ.txt" > "$TMP/typ5.txt"
  while IFS= read -r asset; do
    if too_long "Asset address" "$asset"; then
      continue
    fi
    asset_type=$(expected_type "$asset")
    fetch GET "$asset" "$TMP/asset"
    if [[ "$CODE" != 200 ]]; then
      fail "$asset: HTTP $CODE instead of 200$(fetch_detail)"
    elif [[ "$TYPE" != "$asset_type" ]]; then
      fail "$asset: Content-Type '$TYPE', expected $asset_type"
    else
      ok "$asset: $TYPE"
    fi
  done < "$TMP/typ5.txt"
done

# 7. Panel: account present, installer locked ----------------------------------
if [[ "$PANEL_MODE" == off ]]; then
  note "Panel not checked (GENBA_PANEL_ACCOUNT=off)"
else
  fetch GET "$URL$API_PATH/system" "$TMP/system.json"
  installed=$(LC_ALL=C grep -aoE '"isInstalled":(true|false)' "$TMP/system.json" 2>/dev/null | head -n 1 | LC_ALL=C cut -d: -f2 || true)
  installable=$(LC_ALL=C grep -aoE '"isInstallable":(true|false)' "$TMP/system.json" 2>/dev/null | head -n 1 | LC_ALL=C cut -d: -f2 || true)
  if [[ "$CODE" != 200 || -z "$installed" || -z "$installable" ]]; then
    fail "$API_PATH/system: HTTP $CODE without isInstalled/isInstallable — is this Kirby's Panel API?$(fetch_detail)"
  elif [[ "$installable" == true ]]; then
    fail "Panel can be installed from outside (panel.install on?) — any visitor could become admin"
  elif [[ "$installed" != true ]]; then
    message="Panel without account: $PANEL_PATH shows the installer. Create the account on the server first"
    if [[ "$PANEL_MODE" == require ]]; then
      fail "$message"
    else
      warn "$message"
    fi
  else
    ok "Panel set up (account present, installer locked)"
  fi
fi

# 7b. Panel files: /panel answers, and the JS and CSS it names arrive ----------
# A Panel whose files do not arrive is an empty page for the editors. The
# files are the ones /panel names under /media/panel or /media/plugins; each
# must answer 200 with a script or stylesheet type and a body — a fallback
# route that answers every path with an HTML page, 200, is no Panel file.
# Kirby sends a visitor who is not signed in on to the Panel's login page: one
# redirect is followed, and only when its target lies under /panel — and the
# reload to itself Kirby sends from that page once after an update. Any other
# redirect is a finding, as everywhere else.
if [[ "$PANEL_MODE" != off ]]; then
  # One request: its body is the Panel page, its headers name a redirect's
  # target as the server sent it. curl's own redirect URL would carry the
  # credentials of a protected preview.
  : > "$TMP/panel-head.txt"
  fetch GET "$URL$PANEL_PATH" "$TMP/panel.html" '' "$TMP/panel-head.txt"
  panel_redirect_ok=1
  case "$CODE" in
    301|302|303|307|308)
      # Kirby 5 sends a visitor who is not signed in on with a Refresh header
      # ("0; url=…") rather than a Location: both count (redirect_location).
      panel_location=$(redirect_location "$TMP/panel-head.txt")
      # Kirby writes the target absolute, from its url option: on staging the
      # production origin, or localhost where GENBA_URL says 127.0.0.1. Only
      # the path counts — under /panel of GENBA_URL — and it is fetched on the
      # GENBA_URL origin, as a rewritten sitemap entry is; another origin is
      # said in a -- line.
      panel_target=$(resolve "$URL$PANEL_PATH" "$panel_location")
      panel_path=$(LC_ALL=C sed -E 's|^[a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*||' <<<"$panel_target")
      panel_path=$(resolve "$ORIGIN/" "/${panel_path#/}")
      panel_path=${panel_path#"$ORIGIN"}
      panel_root="${URL#"$ORIGIN"}$PANEL_PATH"
      case "$panel_path" in
        "$panel_root"|"$panel_root/"*|"$panel_root?"*)
          if ! same_origin "$panel_target"; then
            note "$PANEL_PATH sends on to $(log_text "$panel_location") — checked as $(log_text "$panel_path") on $ORIGIN (Kirby's url option names another origin)"
          fi
          : > "$TMP/panel-head.txt"
          fetch GET "$ORIGIN$panel_path" "$TMP/panel.html" '' "$TMP/panel-head.txt"
          # On the first Panel page after an update Kirby links the Panel's
          # files into media/panel and sends the visitor back to the same
          # address (a Location, absolute from its url option, without the
          # query). That one reload is followed; a page that sends on to itself
          # again, or anywhere else, is the finding below.
          case "$CODE" in
            301|302|303|307|308)
              reload_location=$(redirect_location "$TMP/panel-head.txt")
              reload_path=$(resolve "$ORIGIN$panel_path" "$reload_location" \
                | LC_ALL=C sed -E 's|^[a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*||; s|[?].*||')
              if [[ -n "$reload_location" && "$reload_path" == "${panel_path%%\?*}" ]]; then
                note "$(log_text "$panel_path") sends on to itself (Kirby links the Panel files on the first call after an update) — asked once more"
                fetch GET "$ORIGIN$panel_path" "$TMP/panel.html"
              fi
              ;;
          esac
          ;;
        *)
          fail "$PANEL_PATH: HTTP $CODE to '$(log_text "$panel_location")', not to a page under $PANEL_PATH"
          panel_redirect_ok=0
          ;;
      esac
      ;;
  esac
  if (( panel_redirect_ok == 0 )); then
    : # reported above
  elif [[ "$CODE" != 200 ]]; then
    fail "$PANEL_PATH: HTTP $CODE instead of 200$(fetch_detail)"
  else
    LC_ALL=C grep -aoE "/media/(panel|plugins)/[^\"' )<>]+\.(js|css|mjs)" "$TMP/panel.html" 2>/dev/null \
      | LC_ALL=C sort -u > "$TMP/panel-files.txt" || true
    panel_files=0
    panel_broken=0
    while IFS= read -r panel_file; do
      [[ -n "$panel_file" ]] || continue
      panel_files=$((panel_files + 1))
      # A fresh file per fetch, as for the stylesheets: the byte count must not be the previous file's.
      rm -f "$TMP/panel-file"
      fetch GET "$URL$panel_file" "$TMP/panel-file"
      case "$panel_file" in
        *.css) panel_types='text/css' ;;
        *) panel_types='text/javascript|application/javascript|application/x-javascript' ;;
      esac
      # Kirby's plugin bundles are empty when no plugin brings Panel code.
      panel_need=', not empty'
      case "$panel_file" in
        /media/plugins/index.css|/media/plugins/index.js) panel_need='' ;;
      esac
      bytes=0
      if [[ -f "$TMP/panel-file" ]]; then
        bytes=$(wc -c < "$TMP/panel-file" | tr -d ' ')
      fi
      if [[ "$CODE" != 200 ]]; then
        fail "Panel file $(log_text "$panel_file"): HTTP $CODE instead of 200$(fetch_detail)"
        panel_broken=$((panel_broken + 1))
      elif [[ "|$panel_types|" != *"|$TYPE|"* || ( "$bytes" == 0 && -n "$panel_need" ) ]]; then
        fail "Panel file $(log_text "$panel_file"): HTTP $CODE, '$TYPE', $bytes bytes — expected ${panel_types//|/ or }$panel_need"
        panel_broken=$((panel_broken + 1))
      fi
    done < "$TMP/panel-files.txt"
    if (( panel_files == 0 )); then
      fail "$PANEL_PATH names no JS or CSS under /media/panel — an empty Panel page?"
    elif (( panel_broken == 0 )); then
      ok "Panel: $PANEL_PATH answers 200, its $panel_files files arrive"
    fi
  fi
fi

# 8. Nothing above public/ is reachable ------------------------------------------
# With credentials on a protected preview: behind the protection every path is
# 401, which would prove nothing about the document root.
if [[ -z "${PRIVATE_PATHS// /}" ]]; then
  note "private paths not checked (GENBA_PRIVATE_PATHS=none)"
elif [[ "$HOME_CODE" == 000 ]]; then
  note "private paths not checked: the homepage gave no answer (HTTP 000)"
elif [[ "$HOME_CODE" != 200 ]]; then
  note "private paths not checked: the homepage answered HTTP $HOME_CODE, not 200"
else
  private_checked=0
  private_failed=0
  for private_path in $PRIVATE_PATHS; do
    fetch GET "$URL/$private_path" "$TMP/private"
    private_checked=$((private_checked + 1))
    case "$CODE" in
      2??)
        fail "Private path /$private_path answers HTTP $CODE — reachable from the web (document root not on public/?)"
        private_failed=$((private_failed + 1))
        ;;
      000)
        fail "Private path /$private_path: no answer (HTTP 000)$(fetch_detail) — not verified"
        private_failed=$((private_failed + 1))
        ;;
    esac
  done
  if (( private_failed == 0 )); then
    ok "$private_checked private paths not reachable (none answers 2xx)"
  fi
fi

# 9. Response headers (GENBA_HEADERS) ------------------------------------------
# One request per rule, with its own path. The header is read from the last
# response block of that request (no redirect is followed). Rules: a value
# (exact), * (present), none (absent), ~text (contains), !~text (sent and does
# not contain). The path must answer 2xx or 3xx (the Panel answers a visitor
# who is not signed in with 302): the headers of an error page — a typo in the
# path, 404 — say nothing about the page the rule is meant for.
if (( ${#HDR_NAME[@]} == 0 )); then
  note "response headers not checked (GENBA_HEADERS not set)"
else
  for ((h = 0; h < ${#HDR_NAME[@]}; h++)); do
    hdr_where=homepage
    if [[ "${HDR_PATH[h]}" != / ]]; then
      hdr_where=${HDR_PATH[h]}
    fi
    hdr_label="$hdr_where ${HDR_NAME[h]}"
    hdr_want=$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<< "${HDR_NAME[h]}")
    : > "$TMP/headers.txt"
    HDR_CODE=$(curl "${CURL_OPTS[@]}" -D "$TMP/headers.txt" -o /dev/null -w '%{http_code}' \
      "$URL${HDR_PATH[h]}" 2>"$TMP/headers.err") || HDR_CODE=000
    [[ -n "$HDR_CODE" ]] || HDR_CODE=000
    if [[ "$HDR_CODE" == 000 ]]; then
      fail "$hdr_label: no answer (HTTP 000)$(curl_error "$TMP/headers.err" | sed 's/^/ — /')"
      continue
    fi
    if [[ "$HDR_CODE" != [23]?? ]]; then
      fail "$hdr_label: HTTP $HDR_CODE instead of 2xx or 3xx — the header was not checked (path wrong?)"
      continue
    fi
    seen=$(LC_ALL=C awk -v want="$hdr_want" '
      { sub(/\r$/, "") }
      /^HTTP\// { seen = 0; val = ""; next }
      {
        i = index($0, ":")
        if (i == 0) next
        name = tolower(substr($0, 1, i - 1))
        gsub(/[ \t]/, "", name)
        if (name != want) next
        v = substr($0, i + 1)
        sub(/^[ \t]+/, "", v)
        sub(/[ \t]+$/, "", v)
        val = seen ? val ", " v : v
        seen = 1
      }
      END { if (seen) printf "1\t%s\n", val; else print "0\t" }
    ' "$TMP/headers.txt")
    hdr_present=${seen%%$'\t'*}
    hdr_value=${seen#*$'\t'}
    hdr_rule=${HDR_RULE[h]}
    hdr_ok=0
    case "$hdr_rule" in
      '*')
        hdr_expect='present'
        if [[ "$hdr_present" == 1 ]]; then hdr_ok=1; fi
        ;;
      none)
        hdr_expect='absent'
        if [[ "$hdr_present" == 0 ]]; then hdr_ok=1; fi
        ;;
      '~'*)
        hdr_text=${hdr_rule#\~}
        hdr_expect="containing '$hdr_text'"
        if [[ "$hdr_present" == 1 && "$hdr_value" == *"$hdr_text"* ]]; then hdr_ok=1; fi
        ;;
      '!~'*)
        # Sent, and without the text: a CSP that got lost does not pass !~unsafe-inline.
        hdr_text=${hdr_rule#'!~'}
        hdr_expect="not containing '$hdr_text'"
        if [[ "$hdr_present" == 1 && "$hdr_value" != *"$hdr_text"* ]]; then hdr_ok=1; fi
        ;;
      *)
        hdr_expect="exactly '$hdr_rule'"
        if [[ "$hdr_present" == 1 && "$hdr_value" == "$hdr_rule" ]]; then hdr_ok=1; fi
        ;;
    esac
    if (( hdr_ok )); then
      ok "$hdr_label: $hdr_expect (HTTP $HDR_CODE)"
    elif [[ "$hdr_present" == 1 ]]; then
      fail "$hdr_label: sent '$(log_text "$hdr_value")', expected $hdr_expect (HTTP $HDR_CODE)"
    else
      fail "$hdr_label: not sent, expected $hdr_expect (HTTP $HDR_CODE)"
    fi
  done
fi

# 6. http -> https -------------------------------------------------------------
HTTP_URL=${GENBA_HTTP_URL:-}
if [[ "$HTTPS_MODE" == off ]]; then
  note "http→https not checked (GENBA_HTTPS_REDIRECT=off)"
elif [[ -z "$HTTP_URL" && "$URL" != https://* ]]; then
  note "http→https not checked: URL is not https"
else
  if [[ -z "$HTTP_URL" ]]; then
    HTTP_URL="http://$HOST/"
  fi
  # No credentials here: they never travel over unencrypted http. curl's stderr
  # is kept like in fetch(): a connection that fails is "returns
  # '000'" with curl's message, not a bare 000.
  result=$(curl "${CURL_BASIC[@]}" -o /dev/null -w '%{http_code} %{redirect_url}' "$HTTP_URL" 2>"$TMP/http.err" || true)
  code=${result%% *}
  [[ -n "$code" ]] || code=000
  # The target is the server's Location header, printed below: log text.
  target=$(log_text "${result#* }")
  target_origin=$(LC_ALL=C sed -E 's#^(https://[^/]+).*#\1#' <<<"$target")
  if [[ ( "$code" == 301 || "$code" == 308 ) && "$(normalize_origin "$target_origin")" == "$(normalize_origin "https://${ORIGIN#*://}")" ]]; then
    ok "http redirects with $code to $target"
  else
    message="http→https missing: $HTTP_URL returns '$code' with target '$target', expected 301/308 to https://${ORIGIN#*://}"
    if [[ "$code" == 000 ]]; then
      detail=$(curl_error "$TMP/http.err")
      if [[ -n "$detail" ]]; then
        message="$message — $detail"
      fi
    fi
    if [[ "$HTTPS_MODE" == require ]]; then
      fail "$message"
    else
      warn "$message"
    fi
  fi
fi

if [[ "$FAILED" != 0 ]]; then
  echo "Genba smoke: FAILED — see findings above."
  exit 1
fi
echo "Genba smoke: PASSED."
